generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  role      String   @default("usuario") @db.VarChar(30)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  @@map("users")
}

// RUT, nombre, teléfono y correo son obligatorios
model Cliente {
  id          Int         @id @default(autoincrement())
  // opcional en la BD solo por los clientes que existían antes; al registrar o editar se pide
  rut         String?     @unique @db.VarChar(12)
  nombre      String      @db.VarChar(150)
  telefono    String      @db.VarChar(30)
  correo      String      @db.VarChar(255)
  solicitudes Solicitud[]
  createdAt   DateTime    @default(now()) @db.Timestamp(6)
  updatedAt   DateTime    @updatedAt @db.Timestamp(6)

  @@map("clientes")
}

enum EstadoSolicitud {
  pendiente
  // ya tiene todos los datos obligatorios
  registrada
  // lo pone quien confirma el evento; con esto se ven los choques de horario
  confirmado
}

enum TipoPrecio {
  fijo     @map("Precio fijo")
  por_hora @map("Por hora")
}

enum EstadoCambioServicio {
  pendiente
  aprobado
  rechazado
}

enum EstadoVersionServicio {
  activo
  inactivo
}

// Solicitud de evento. Si le falta algún dato queda pendiente
model Solicitud {
  id                     Int                 @id @default(autoincrement())
  clienteId              Int
  cliente                Cliente             @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  tipoEvento             String?             @db.VarChar(100)
  fecha                  DateTime?           @db.Date
  horaInicio             DateTime?           @db.Time(0)
  horaFin                DateTime?           @db.Time(0)
  cantidadPersonas       Int?
  lugar                  String?             @db.VarChar(255)
  requerimientosTecnicos String?             @db.Text
  // servicios adicionales (del catálogo)
  servicios              SolicitudServicio[]
  estado                 EstadoSolicitud     @default(pendiente)
  // true si la fecha y hora se revisaron y no chocan con nada
  fechaHabilitada        Boolean             @default(false)
  cambios                SolicitudCambio[]
  historial              HistorialEvento[]
  createdAt              DateTime            @default(now()) @db.Timestamp(6)
  updatedAt              DateTime            @updatedAt @db.Timestamp(6)

  @@index([clienteId])
  @@index([fecha])
  @@map("solicitudes")
}

enum EstadoCambio {
  pendiente
  aprobado
  rechazado
}

// Cambio que pide el cliente sobre un evento ya confirmado
model SolicitudCambio {
  id                   Int               @id @default(autoincrement())
  solicitudId          Int
  solicitud            Solicitud         @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  // ej: { "horaFin": "23:59", "lugar": "Salón Sur" }
  cambios              Json
  motivo               String            @db.Text
  estado               EstadoCambio      @default(pendiente)
  registradoPor        String            @db.VarChar(150)
  // lo que revisa gerencia antes de aprobar
  revisionRecursos     Boolean           @default(false)
  revisionAnticipacion Boolean           @default(false)
  revisionCosto        Boolean           @default(false)
  revisionOtrosEventos Boolean           @default(false)
  revisadoPor          String?           @db.VarChar(150)
  revisadoEn           DateTime?         @db.Timestamp(6)
  // se llena cuando el cambio se aplica al evento
  aplicadoPor          String?           @db.VarChar(150)
  aplicadoEn           DateTime?         @db.Timestamp(6)
  historial            HistorialEvento[]
  createdAt            DateTime          @default(now()) @db.Timestamp(6)
  updatedAt            DateTime          @updatedAt @db.Timestamp(6)

  @@index([solicitudId])
  @@map("solicitudes_cambio")
}

// Un registro por cada dato que se le cambió al evento
model HistorialEvento {
  id            Int             @id @default(autoincrement())
  solicitudId   Int
  solicitud     Solicitud       @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  cambioId      Int
  cambio        SolicitudCambio @relation(fields: [cambioId], references: [id], onDelete: Restrict)
  campo         String          @db.VarChar(50)
  valorAnterior String?         @db.Text
  valorNuevo    String?         @db.Text
  usuario       String          @db.VarChar(150)
  createdAt     DateTime        @default(now()) @db.Timestamp(6)

  @@index([solicitudId])
  @@map("historial_eventos")
}

// Categoría utilizada para agrupar los servicios ofrecidos.
model TipoServicio {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(100)
  descripcion String?    @db.Text
  activo      Boolean    @default(true)
  servicios   Servicio[]
  createdAt   DateTime   @default(now()) @db.Timestamp(6)
  updatedAt   DateTime   @updatedAt @db.Timestamp(6)

  @@map("tipos_servicio")
}

// Servicio comercial asociado obligatoriamente a un tipo registrado.
model Servicio {
  id             Int                     @id @default(autoincrement())
  tipoServicioId Int
  tipoServicio   TipoServicio            @relation(fields: [tipoServicioId], references: [id], onDelete: Restrict)
  nombre         String                  @db.VarChar(150)
  descripcion    String?                 @db.Text
  activo         Boolean                 @default(true)
  versiones      VersionServicio[]
  cambios        CambioServicio[]
  solicitudes    SolicitudServicio[]
  createdAt      DateTime                @default(now()) @db.Timestamp(6)
  updatedAt      DateTime                @updatedAt @db.Timestamp(6)

  @@index([tipoServicioId])
  @@map("servicios")
}

// Precio y modalidad que estuvieron vigentes para un servicio.
model VersionServicio {
  id             Int                   @id @default(autoincrement())
  servicioId     Int
  servicio       Servicio              @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  tipoPrecio     TipoPrecio
  precio         Int
  estado         EstadoVersionServicio @default(activo)
  vigenciaDesde  DateTime              @db.Date
  vigenciaHasta  DateTime?             @db.Date
  solicitudes    SolicitudServicio[]

  @@index([servicioId, estado])
  @@map("versiones_servicio")
}

// Nuevo precio o modalidad solicitado por Producción y Comercial.
model CambioServicio {
  id                   Int                  @id @default(autoincrement())
  servicioId           Int
  servicio             Servicio             @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  tipoPrecioNuevo      TipoPrecio
  precioNuevo          Int
  estado               EstadoCambioServicio @default(pendiente)

  @@index([servicioId])
  @@index([estado])
  @@map("cambios_servicio")
}

// Relación explícita entre las solicitudes y los servicios seleccionados.
model SolicitudServicio {
  id                Int             @id @default(autoincrement())
  solicitudId       Int
  servicioId        Int
  versionServicioId Int
  solicitud         Solicitud       @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  servicio          Servicio        @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  versionServicio   VersionServicio @relation(fields: [versionServicioId], references: [id], onDelete: Restrict)

  @@unique([solicitudId, servicioId])
  @@index([servicioId])
  @@index([versionServicioId])
  @@map("solicitudes_servicios")
}

model Inventario {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(150)
  precio    Decimal  @db.Decimal(10, 2)
  stock     Int
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  @@map("inventario")
}
