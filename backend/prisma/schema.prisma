generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  role      String   @default("usuario") @db.VarChar(30)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  @@map("users")
}

// Datos obligatorios del cliente definidos por la empresa.
model Cliente {
  id          Int         @id @default(autoincrement())
  nombre      String      @db.VarChar(150)
  telefono    String      @db.VarChar(30)
  correo      String      @db.VarChar(255)
  solicitudes Solicitud[]
  createdAt   DateTime    @default(now()) @db.Timestamp(6)
  updatedAt   DateTime    @updatedAt @db.Timestamp(6)

  @@map("clientes")
}

enum EstadoSolicitud {
  pendiente
  disponible_cotizar
  // Lo asigna el proceso que confirma el evento; se usa para detectar conflictos de horario.
  confirmado
}

enum TipoPrecio {
  fijo
  por_hora
}

// Solicitud de evento. Los datos pueden faltar: en ese caso queda pendiente.
model Solicitud {
  id                     Int                 @id @default(autoincrement())
  clienteId              Int
  cliente                Cliente             @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  fecha                  DateTime?           @db.Date
  horaInicio             DateTime?           @db.Time(0)
  horaFin                DateTime?           @db.Time(0)
  cantidadPersonas       Int?
  lugar                  String?             @db.VarChar(255)
  servicios              String?             @db.Text
  serviciosSeleccionados SolicitudServicio[]
  estado                 EstadoSolicitud     @default(pendiente)
  // La fecha y horario fueron revisados sin conflicto y pueden continuar a confirmación.
  fechaHabilitada        Boolean             @default(false)
  createdAt              DateTime            @default(now()) @db.Timestamp(6)
  updatedAt              DateTime            @updatedAt @db.Timestamp(6)

  @@index([clienteId])
  @@index([fecha])
  @@map("solicitudes")
}

// Categoría utilizada para agrupar los servicios ofrecidos.
model TipoServicio {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(100)
  descripcion String?    @db.Text
  activo      Boolean    @default(true)
  servicios   Servicio[]
  createdAt   DateTime   @default(now()) @db.Timestamp(6)
  updatedAt   DateTime   @updatedAt @db.Timestamp(6)

  @@map("tipos_servicio")
}

// Servicio comercial asociado obligatoriamente a un tipo registrado.
model Servicio {
  id             Int                 @id @default(autoincrement())
  tipoServicioId Int
  tipoServicio   TipoServicio        @relation(fields: [tipoServicioId], references: [id], onDelete: Restrict)
  nombre         String              @db.VarChar(150)
  descripcion    String?             @db.Text
  tipoPrecio     TipoPrecio
  precio         Int
  activo         Boolean             @default(true)
  solicitudes    SolicitudServicio[]
  createdAt      DateTime            @default(now()) @db.Timestamp(6)
  updatedAt      DateTime            @updatedAt @db.Timestamp(6)

  @@index([tipoServicioId])
  @@map("servicios")
}

// Relación explícita entre las solicitudes y los servicios seleccionados.
model SolicitudServicio {
  id          Int       @id @default(autoincrement())
  solicitudId Int
  servicioId  Int
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Restrict)
  servicio    Servicio  @relation(fields: [servicioId], references: [id], onDelete: Restrict)

  @@unique([solicitudId, servicioId])
  @@index([servicioId])
  @@map("solicitudes_servicios")
}
